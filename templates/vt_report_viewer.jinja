    <div id="message-modal" class="modal-overlay">
        <div class="modal-box">
            <h3 id="modal-title" class="text-xl font-bold mb-4">Processing...</h3>
            <p id="modal-message" class="text-gray-600 mb-6">Please wait while we analyze the data.</p>
            <div id="modal-spinner" class="flex justify-center mb-4">
                <div class="loader" style="color: #0d6efd;"></div>
            </div>
            <button id="modal-close"
                class="w-full bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded-lg hidden transition">Close</button>
        </div>
