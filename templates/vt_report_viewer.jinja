<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>VirusTotal Intelligence Report</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='dist/tailwind.css') }}">


    <style>
        /* ====1. GLOBAL & TYPOGRAPHY==== */
        body {
            background-color: #f3f4f6;
            /* bg-gray-100 */
            font-family: 'Inter', sans-serif;
            color: #1f2937;
        }

        .main-container {
            max-width: 95%;
            /* Increased width */
            margin: 0 auto;
        }

        .text-gradient {
            background: linear-gradient(90deg, #0d6efd, #0890ffff);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Section Headers */
        .section-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #9ca3af;
            margin-bottom: 1rem;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 0.5rem;
        }

        .prop-label {
            color: #9ca3af;
            font-size: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .prop-value {
            font-weight: 500;
            color: #1f2937;
        }

        /* =====2. CARDS & PANELS===== */
        .vt-card {
            background-color: white;
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border: 1px solid #e5e7eb;
            padding: 1.5rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .vt-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border-color: #507BFC;
        }

        /* Header Card specifics */
        .header-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            background-color: white;
            padding: 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border: 1px solid #e5e7eb;
        }

        @media (min-width: 768px) {
            .header-card {
                flex-direction: row;
            }
        }

        /* ====3. BUTTONS & INTERACTIVE===== */
        .btn {
            display: inline-flex;
            align-items: center;
            font-weight: 700;
            padding: 0.5rem 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-primary {
            background-color: #00d1b2;
            color: white;
        }

        .btn-primary:hover {
            background-color: #0d9488;
        }

        .btn-secondary {
            background-color: #a855f7;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #9333ea;
        }

        .btn-dark {
            background-color: #4b5563;
            color: white;
        }

        .btn-dark:hover {
            background-color: #374151;
        }

        .btn-close {
            display: inline-block;
            font-size: 0.95rem;
            background: #e7f0ff;
            color: #0d6efd;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.2s, transform 0.2s;
        }

        .btn-close:hover {
            background: #d6e4ff;
            transform: translateY(-1px);
        }

        /* =====4. DATA TABLE STYLES===== */
        .vt-table-container {
            overflow-x: auto;
            max-height: 24rem;
            /* max-h-96 */
            border-top: 1px solid #e5e7eb;
        }

        /* Scrollbar styling for table */
        .vt-table-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .vt-table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .vt-table-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
        }

        .vt-table-container::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

        .vt-table {
            width: 100%;
            text-align: left;
            font-size: 0.875rem;
        }

        .vt-table th {
            background-color: #F0F2FF;
            color: #0d6efd;
            font-weight: 600;
            padding: 0.875rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
        }

        .vt-table td {
            padding: 0.75rem 1.5rem;
        }

        .vt-table tr {
            border-bottom: 1px solid #f3f4f6;
            transition: background-color 0.2s;
        }

        .vt-table tr:hover {
            background-color: #f9fafb;
        }

        /* =====5. VISUALIZATIONS (Gauge, Tags, JSON)===== */
        /* Gauge Animation */
        .gauge-circle {
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        .gauge-value {
            transition: stroke-dashoffset 1s ease-out;
        }

        /* Tags */
        .tag-pill {
            background-color: #f3f4f6;
            color: #4b5563;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid #e5e7eb;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* JSON Code Block */
        .json-code {
            white-space: pre-wrap;
            word-wrap: break-word;
            font-size: 0.85rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            color: #4ade80;
        }

        /* =====6. MODAL & ALERTS===== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(17, 24, 39, 0.6);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            z-index: 50;
            backdrop-filter: blur(4px);
        }

        .modal-overlay.flex {
            display: flex;
        }

        .modal-box {
            background: white;
            border-radius: 0.75rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            padding: 2rem;
            max-width: 24rem;
            width: 100%;
            text-align: center;
        }

        .llm-result-box {
            display: none;
            background: white;
            padding: 2rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #0d6efd;
        }

        .llm-result-box.active {
            display: block;
        }

        /* TOGGLE BUTTON STYLES */
        .cursor-pointer {
            cursor: pointer;
        }

        .transition-transform {
            transition: transform 0.3s ease;
        }

        /* Rotates the icon 180 degrees */
        .rotate-180 {
            transform: rotate(180deg);
        }

        /* Smooth reveal for content */
        .content-transition {
            transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
            overflow: hidden;
        }

        /* Hidden state styles */
        .content-hidden {
            max-height: 0;
            opacity: 0;
            margin: 0;
            padding: 0;
        }
    </style>
</head>

<body class="p-4 md:p-8">

    <script type="text/javascript">
        const __app_id = 'json-viewer-app';
        const __firebase_config = '{}';
        const __initial_auth_token = '';
    </script>
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        const firebaseConfig = JSON.parse('{}');
        try {
            const app = initializeApp(firebaseConfig);
            const auth = getAuth(app);
            signInAnonymously(auth);
        } catch (e) { console.error("Firebase Init Error", e); }
    </script>
    <script>
        const SERVER_DATA = {{ report_data | tojson | default ('null') | safe }};
        const RESOURCE_TYPE = {{ resource_type | tojson | default ('""') | safe }};
        let RESOURCE_ID = {{ resource_id | tojson | default ('""') | safe }};
        // Decode ID if it was URL-encoded to pass through routing
        if (RESOURCE_TYPE === 'url' && RESOURCE_ID.includes('%')) {
            try {
                RESOURCE_ID = decodeURIComponent(RESOURCE_ID);
                // Clean up any trailing newlines or whitespace (common in email extractions)
                RESOURCE_ID = RESOURCE_ID.trim();
            } catch (e) { console.warn("ID Decode Error", e); }
        }
    </script>
    <script src="{{ url_for('static', filename='spinner.js') }}"></script>

    <div class="main-container space-y-6">

        <div class="header-card">
            <div class="flex items-center gap-3 min-w-0">
                <img width="40" height="40" class="flex-shrink-0"
                    src="https://img.icons8.com/fluency/40/pie-chart-report-script.png" alt="icon" />
                <div class="min-w-0">
                    <h1 class="text-xl font-bold text-gray-800 text-gradient">VirusTotal Analysis Report</h1>
                    <p class="text-sm text-gray-500 font-mono break-all" id="header-id">Loading ID...</p>
                </div>
            </div>
            <a href="javascript:window.close()" class="btn-close mt-4 md:mt-0 flex-shrink-0">
                <span>✕</span> Close Tab
            </a>
        </div>

        <!-- Cache Notification Bar -->
        <div id="cache-status-bar"
            class="hidden bg-blue-50 border border-blue-200 rounded-lg p-3 flex justify-between items-center">
            <div class="flex items-center gap-2 text-sm text-blue-800">
                <span>ℹ️</span>
                <span id="cache-msg">Viewing cached report</span>
            </div>
            <button id="reanalyze-btn"
                class="text-xs bg-white border border-blue-300 hover:bg-blue-50 text-blue-700 font-semibold py-1 px-3 rounded transition cursor-pointer">
                🔄 Re-Analyze (Fetch Fresh)
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6">

            <div class="vt-card flex flex-col items-center justify-center relative overflow-hidden !p-4">
                <h2 class="section-label mb-3">Detection Score</h2>

                <div class="relative w-32 h-32">
                    <svg class="w-full h-full gauge-circle" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="45" fill="none" stroke="#f3f4f6" stroke-width="8"></circle>
                        <circle id="gauge-path" cx="50" cy="50" r="45" fill="none" stroke="#ff4b4b" stroke-width="8"
                            stroke-dasharray="283" stroke-dashoffset="283" stroke-linecap="round" class="gauge-value">
                        </circle>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span id="score-display" class="text-5xl font-bold text-gray-800">0</span>
                        <span id="total-display" class="text-xs text-gray-400 font-medium">/ 0</span>
                    </div>
                </div>

                <p id="verdict-label" class="mt-2 text-sm font-bold text-gray-700 lg:whitespace-nowrap">Analyzing...</p>
            </div>

            <div class="vt-card !p-4">
                <h2 class="section-label mb-2 border-b pb-1">Details</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                    <div>
                        <p class="prop-label">Type</p>
                        <p id="prop-type" class="prop-value truncate">N/A</p>
                    </div>
                    <div>
                        <p class="prop-label">File Size</p>
                        <p id="prop-size" class="prop-value truncate">N/A</p>
                    </div>
                    <div>
                        <p class="prop-label">First Seen</p>
                        <p id="prop-seen" class="prop-value">N/A</p>
                    </div>
                    <div>
                        <p class="prop-label">Last Analysis</p>
                        <p id="prop-date" class="prop-value">N/A</p>
                    </div>
                    <div class="md:col-span-2">
                        <p class="prop-label">Meaningful Name / URL</p>
                        <p id="prop-name" class="prop-value truncate bg-gray-50 p-2 rounded border border-gray-100">N/A
                        </p>
                    </div>
                </div>

                <div class="mt-3">
                    <p class="prop-label mb-2">Tags</p>
                    <div id="tags-container" class="flex flex-wrap gap-2">
                        <span class="text-xs text-gray-400 italic">No tags available</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="vt-card p-0 overflow-hidden">
            <!-- Tab Header -->
            <div class="bg-gray-50 px-6 border-b border-gray-200 flex justify-between items-center">
                <div class="flex space-x-6">
                    <button id="tab-btn-detection" onclick="switchTab('detection')"
                        class="px-3 py-3 text-sm font-bold text-blue-600 border-b-2 border-blue-600 focus:outline-none transition-colors">
                        Detection
                    </button>
                    <button id="tab-btn-details" onclick="switchTab('details')"
                        class="px-3 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 focus:outline-none transition-colors">
                        Details
                    </button>
                    <button id="tab-btn-behavior" onclick="switchTab('behavior')"
                        class="hidden px-3 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 focus:outline-none transition-colors">
                        Behavior Report
                    </button>
                    <button id="tab-btn-relations" onclick="switchTab('relations')"
                        class="hidden px-3 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 focus:outline-none transition-colors">
                        Relations
                    </button>
                    <button id="tab-btn-hardlinks" onclick="switchTab('hardlinks')"
                        class="px-3 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 focus:outline-none transition-colors">
                        Hard Link
                    </button>
                </div>
                <span class="bg-gray-200 text-gray-600 text-xs font-bold px-2 py-1 rounded-full my-2">Detection Score
                    <span id="detection-count-badge"
                        class="bg-gray-200 text-gray-600 text-xs font-bold px-2 py-1 rounded-full my-2">0</span>
                </span>
            </div>

            <!-- Tab Content: Detection -->
            <div id="tab-content-detection" class="vt-table-container">
                <table class="vt-table">
                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th>Result</th>
                            <th>Version</th>
                            <th>Last Update</th>
                        </tr>
                    </thead>
                    <tbody id="detection-table-body" class="bg-white">
                    </tbody>
                </table>
            </div>

            <!-- Tab Content: Details -->
            <div id="tab-content-details" class="hidden p-6 space-y-8">

                <!-- Basic Properties (Files) -->
                <div id="section-basic-props" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="Basic attributes that allow you to further identify the file being studied.">
                        Basic Properties <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 text-sm">
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">MD5</span><span
                                id="detail-md5" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">SHA-1</span><span
                                id="detail-sha1" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">SHA-256</span><span
                                id="detail-sha256" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">Vhash</span><span
                                id="detail-vhash" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">SSDEEP</span><span
                                id="detail-ssdeep" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">TLSH</span><span
                                id="detail-tlsh" class="font-mono text-gray-800 break-all select-all">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">File Type</span><span
                                id="detail-type" class="text-gray-800">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">Magic</span><span
                                id="detail-magic" class="text-gray-800">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">TrID</span>
                            <div id="detail-trid" class="text-gray-800 text-xs">-</div>
                        </div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">Magika</span><span
                                id="detail-magika" class="text-gray-800">-</span></div>
                        <div class="grid grid-cols-[120px_1fr] gap-2"><span class="text-gray-500">File Size</span><span
                                id="detail-size" class="text-gray-800">-</span></div>
                    </div>
                </div>

                <!-- History (Files & URLs) -->
                <div id="section-history" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="Relevant dates related to the file being studied">
                        History <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                        <div>
                            <p class="text-gray-500 text-xs mb-1">First Submission</p>
                            <p id="hist-first" class="font-medium">-</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs mb-1">Last Submission</p>
                            <p id="hist-last-sub" class="font-medium">-</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs mb-1">Last Analysis</p>
                            <p id="hist-last-anal" class="font-medium">-</p>
                        </div>
                    </div>
                </div>

                <!-- Names (Files) -->
                <div id="section-names" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="Names with which this file has been submitted or seen in the wild">
                        Names <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <div id="names-list"
                        class="bg-gray-50 p-3 rounded border border-gray-200 text-sm font-mono text-gray-700 max-h-40 overflow-y-auto">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Categories (URLs) -->
                <div id="section-categories" class="hidden">
                    <h3 class="section-label">Categories</h3>
                    <div id="categories-list" class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- HTTP Response (URLs) -->
                <div id="section-http" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="Data gathered from standard HyperText Transfer Protocol communication when asking for the URL being studied.">
                        HTTP Response <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <div class="space-y-4 text-sm">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <p class="text-gray-500 text-xs mb-1">Final URL</p>
                                <p id="http-final-url"
                                    class="font-mono bg-gray-50 p-2 rounded border border-gray-200 break-all text-xs">-
                                </p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs mb-1">Serving IP Address</p>
                                <p id="http-serving-ip" class="font-mono font-bold text-blue-600">-</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs mb-1">Status Code</p>
                                <p id="http-status-code" class="font-mono font-medium">-</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs mb-1">Body Length</p>
                                <p id="http-body-length" class="font-mono">-</p>
                            </div>
                        </div>

                        <div>
                            <p class="text-gray-500 text-xs mb-1">Body SHA-256</p>
                            <div class="flex items-center gap-2">
                                <code id="http-body-sha256"
                                    class="font-mono text-xs bg-gray-100 p-2 rounded border border-gray-200 break-all">-</code>
                                <button onclick="copyToClipboard('http-body-sha256', this)"
                                    class="text-xs bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-3 py-1 rounded transition font-medium">Copy</button>
                            </div>
                        </div>

                        <!-- Headers Mini Table -->
                        <div>
                            <h4 class="font-bold text-gray-700 text-xs uppercase mb-2 border-b border-gray-200 pb-1">
                                Response Headers</h4>
                            <div class="bg-white border border-gray-200 rounded overflow-hidden">
                                <table class="w-full text-xs text-left">
                                    <tbody id="http-headers-body" class="divide-y divide-gray-100">
                                        <!-- Populated by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HTML Info -->
                <div id="section-html-info" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="The file being studied is an HTML file. These details are extracted from the file.">
                        HTML Info <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <div class="space-y-3 text-sm">
                        <div>
                            <p class="text-gray-500 text-xs mb-1">Page Title</p>
                            <p id="html-title" class="font-medium text-gray-800">-</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs mb-1">Meta Tags</p>
                            <div id="html-meta-tags" class="grid grid-cols-1 gap-2">
                                <!-- JS Populated -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cookies -->
                <div id="section-cookies" class="hidden">
                    <h3 class="section-label">Cookies</h3>
                    <div id="cookies-list" class="space-y-2 text-sm">
                        <!-- JS Populated -->
                    </div>
                </div>

                <!-- Whois (IPs) -->
                <div id="section-whois" class="hidden">
                    <h3 class="section-label flex items-center gap-2"
                        title="Domain registration information as provided by its whois lookup.">
                        Whois Lookup <span class="cursor-help text-gray-400">ⓘ</span>
                    </h3>
                    <pre id="whois-content"
                        class="bg-gray-900 text-green-400 p-4 rounded text-xs font-mono overflow-x-auto whitespace-pre-wrap max-h-96">
                        <!-- Populated by JS -->
                    </pre>
                </div>

            </div>

            <!-- Tab Content: Behavior -->
            <div id="tab-content-behavior" class="hidden p-6 space-y-8"></div>

            <!-- Tab Content: Relations (IP Only) -->
            <div id="tab-content-relations" class="hidden p-6 space-y-10">

                <!-- Passive DNS -->
                <div id="rel-dns-section" class="hidden">
                    <h3 class="section-label mb-3 flex items-center gap-2">
                        Passive DNS Replication
                        <span class="cursor-help text-gray-400"
                            title="The following domains resolved to the given IP address">ⓘ</span>
                        <span id="rel-dns-badge"
