    <script>
        let REPORT_DATA = null;

        // Fallback Mock Data
        const MOCK_DATA = { data: { id: "mock_id", type: "file", attributes: { last_analysis_stats: { malicious: 5, harmless: 70 }, tags: ["trojan", "peexe"], last_analysis_results: { "VendorA": { category: "malicious", result: "Trojan.Win32" } } } } };

        window.onload = function () {
            if (SERVER_DATA) {
                populateUI(SERVER_DATA);
            } else if (RESOURCE_ID && RESOURCE_TYPE) {
                showModal("Analyzing...", "Querying VirusTotal API (approx 15s)...");
                fetch(`/api/fetch_vt_report/${RESOURCE_TYPE}/${encodeURIComponent(RESOURCE_ID)}`)
                    .then(res => {
                        if (!res.ok) throw new Error(`Server Error: ${res.status}`);
                        return res.json();
                    })
                    .then(data => {
                        if (data.error) throw new Error(data.error);

                        if (data.data && data.data.type === 'analysis_queued') {
                            showModal("Analysis Queued", "This URL was not found in VirusTotal. A new scan has been triggered. The page will reload in 10 seconds.", false);
                            setTimeout(() => location.reload(), 10000);
                            return;
                        }

                        hideModal();
                        populateUI(data);
                    })
                    .catch(err => { showModal("Error", err.message, true); });
            } else {
                console.warn("Using Mock Data");
                populateUI(MOCK_DATA);
            }
        };

        function populateUI(dataObj) {
            REPORT_DATA = dataObj;
            if (!REPORT_DATA || !REPORT_DATA.data) {
                console.error("No valid report data found.");
                return;
            }

            // --- CACHE HANDLING ---
            const cacheMeta = REPORT_DATA._cache_metadata;
            const cacheBar = document.getElementById('cache-status-bar');

            if (cacheMeta && cacheMeta.cached) {
                cacheBar.classList.remove('hidden');
                document.getElementById('cache-msg').textContent = `Viewing cached data from ${cacheMeta.cached_at}`;
                document.getElementById('reanalyze-btn').onclick = () => {
                    showModal("Re-Analyzing...", "Forcing fresh lookup from VirusTotal (approx 15s)...");
                    fetch(`/api/fetch_vt_report/${RESOURCE_TYPE}/${encodeURIComponent(RESOURCE_ID)}?force=true`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.error) throw new Error(data.error);
                            hideModal();
                            populateUI(data);
                        })
                        .catch(err => { showModal("Error", err.message, true); });
                };
            } else {
                cacheBar.classList.add('hidden');
            }

            // --- POPULATE UI ---
            const data = REPORT_DATA.data;
            const attrs = data.attributes || {};
            const stats = attrs.last_analysis_stats || { malicious: 0, harmless: 0, undetected: 0 };
            const type = data.type || RESOURCE_TYPE; // 'file', 'url', 'ip_address'

            // 1. Header
            let headerLabel = data.id || 'Unknown ID';
            if (type === 'ip_address') headerLabel = `IP: ${data.id}`;
            else if (type === 'file') headerLabel = `Hash: ${data.id}`;
            else if (type === 'url') headerLabel = `URL: ${attrs.url || 'Unknown'}`;

            document.getElementById('header-id').textContent = headerLabel;
            document.getElementById('report-data-json-display').textContent = JSON.stringify(REPORT_DATA, null, 2);

            // 2. Properties
            document.getElementById('prop-type').textContent = attrs.type_description || data.type || 'N/A';
            document.getElementById('prop-size').textContent = attrs.size ? (attrs.size / 1024).toFixed(2) + ' KB' : 'N/A';
            document.getElementById('prop-name').textContent = (attrs.names && attrs.names.length > 0) ? attrs.names[0] : (attrs.meaningful_name || attrs.url || 'N/A');

            // --- DATE FORMATTING CHANGE HERE (YYYY-MM-DD) ---
            const formatDate = (ts) => {
                if (!ts) return 'N/A';
                // 'en-CA' outputs YYYY-MM-DD while keeping local timezone
                return new Date(ts * 1000).toLocaleDateString('en-CA');
            };

            document.getElementById('prop-seen').textContent = formatDate(attrs.first_submission_date);
            document.getElementById('prop-date').textContent = formatDate(attrs.last_analysis_date);

            // 3. Tags
            const tagContainer = document.getElementById('tags-container');
            tagContainer.innerHTML = ''; // Clear defaults
            if (attrs.tags && attrs.tags.length > 0) {
                attrs.tags.forEach(tag => {
                    const span = document.createElement('span');
                    // Uses new .tag-pill class from style tag
                    span.className = "tag-pill";
                    span.textContent = tag;
                    tagContainer.appendChild(span);
                });
            } else {
                tagContainer.innerHTML = '<span class="text-xs text-gray-400 italic">No tags available</span>';
            }

            // 4. Gauge Logic
            const malicious = stats.malicious || 0;
            const total = (stats.malicious + stats.undetected + stats.harmless + stats.suspicious) || 0;

            document.getElementById('score-display').textContent = malicious;
            document.getElementById('total-display').textContent = `/ ${total}`;

            // Gauge Animation
            const circle = document.getElementById('gauge-path');
            const circumference = 2 * Math.PI * 45; // r=45 -> 282.7
            const percentage = total > 0 ? (malicious / total) : 0;
            const offset = circumference - (percentage * circumference); // 0 malicious = full offset (hidden)

            // Color & Verdict Logic
            const verdictLabel = document.getElementById('verdict-label');

            if (malicious === 0) {
                circle.setAttribute('stroke', '#00d1b2'); // Green
                document.getElementById('score-display').classList.replace('text-gray-800', 'text-teal-500');
                verdictLabel.textContent = "No security vendors flagged this file as malicious";
                verdictLabel.className = "mt-2 text-xs font-medium text-teal-600 lg:whitespace-nowrap";
            } else if (malicious < 3) {
                circle.setAttribute('stroke', '#ffdd57'); // Yellow
                document.getElementById('score-display').classList.replace('text-gray-800', 'text-yellow-500');
                verdictLabel.textContent = "Suspicious / Low Detection";
                verdictLabel.className = "mt-2 text-sm font-bold text-yellow-600 lg:whitespace-nowrap";
            } else {
                circle.setAttribute('stroke', '#ff4b4b'); // Red
                document.getElementById('score-display').classList.replace('text-gray-800', 'text-red-600');
                verdictLabel.textContent = "Malicious / High Confidence";
                verdictLabel.className = "mt-2 text-sm font-bold text-red-600 lg:whitespace-nowrap";
            }

            // Trigger Animation
            setTimeout(() => { circle.style.strokeDashoffset = offset; }, 100);

            // 5. Detection Table Population
            const results = attrs.last_analysis_results || {};
            const tbody = document.getElementById('detection-table-body');
            let detectedCount = 0;

            // Convert to array and sort: Malicious first
            const sortedVendors = Object.entries(results).sort((a, b) => {
                const priority = { 'malicious': 1, 'suspicious': 2, 'harmless': 3 };
                const pA = priority[a[1].category] || 4; // 4 = undetected, type-unsupported, failure
                const pB = priority[b[1].category] || 4;
                // Sort by priority, then alphabetically by vendor name
                return (pA - pB) || a[0].localeCompare(b[0]);
            });

            sortedVendors.forEach(([vendor, res]) => {
                const tr = document.createElement('tr');
                // Removed explicit border/hover classes here as they are now in .vt-table tr CSS

                let resultHtml = `<span class="text-gray-400 flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-gray-300"></span> ${res.result || 'Undetected'}</span>`;

                if (res.category === 'malicious') {
                    detectedCount++;
                    resultHtml = `<span class="text-red-600 font-bold flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-red-500"></span> ${res.result || 'Malicious'}</span>`;
                } else if (res.category === 'suspicious') {
                    resultHtml = `<span class="text-yellow-600 font-medium flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-yellow-500"></span> ${res.result || 'Suspicious'}</span>`;
                }

                let dateStr = res.engine_update ? String(res.engine_update) : '-';
                if (dateStr.length === 8 && !isNaN(dateStr)) {
                    dateStr = `${dateStr.substring(0, 4)}-${dateStr.substring(4, 6)}-${dateStr.substring(6, 8)}`;
                }

                tr.innerHTML = `
                    <td class="font-medium text-gray-900">${vendor}</td>
                    <td>${resultHtml}</td>
                    <td class="text-gray-400 text-xs">${res.engine_version || '-'}</td>
                    <td class="text-gray-400 text-xs">${dateStr}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('detection-count-badge').textContent = detectedCount;

            // 6. Populate Details Tab
            const formatTime = (ts) => ts ? new Date(ts * 1000).toLocaleString() : '-';

            // --- Basic Properties (File) ---
            if (type === 'file') {
                document.getElementById('section-basic-props').classList.remove('hidden');
                document.getElementById('detail-md5').textContent = attrs.md5 || '-';
                document.getElementById('detail-sha1').textContent = attrs.sha1 || '-';
                document.getElementById('detail-sha256').textContent = attrs.sha256 || '-';
                document.getElementById('detail-vhash').textContent = attrs.vhash || '-';
                document.getElementById('detail-ssdeep').textContent = attrs.ssdeep || '-';
                document.getElementById('detail-tlsh').textContent = attrs.tlsh || '-';
                document.getElementById('detail-type').textContent = attrs.type_description || '-';
                document.getElementById('detail-magic').textContent = attrs.magic || '-';
                document.getElementById('detail-magika').textContent = attrs.magika || '-';
                document.getElementById('detail-size').textContent = attrs.size ? (attrs.size).toLocaleString() + ' bytes' : '-';

                if (attrs.trid && attrs.trid.length) {
                    document.getElementById('detail-trid').innerHTML = attrs.trid.map(t =>
                        `<div>${t.file_type} <span class="text-gray-400">(${t.probability}%)</span></div>`
                    ).join('');
                }
            }

            // --- History (File & URL) ---
            if (type === 'file' || type === 'url') {
                document.getElementById('section-history').classList.remove('hidden');
                document.getElementById('hist-first').textContent = formatTime(attrs.first_submission_date);
                document.getElementById('hist-last-sub').textContent = formatTime(attrs.last_submission_date);
                document.getElementById('hist-last-anal').textContent = formatTime(attrs.last_analysis_date);
            }

            // --- Names (File) ---
            if (type === 'file' && attrs.names && attrs.names.length) {
                document.getElementById('section-names').classList.remove('hidden');
                document.getElementById('names-list').innerHTML = attrs.names.map(n => `<div>${n}</div>`).join('');
            }

            // --- Categories (URL) ---
            if (type === 'url' && attrs.categories) {
                document.getElementById('section-categories').classList.remove('hidden');
                const cats = Object.entries(attrs.categories).map(([vendor, cat]) =>
                    `<div class="flex flex-col border-b border-gray-100 pb-1">
                        <span class="font-medium text-gray-700">${vendor}</span>
                        <span class="text-gray-500 text-xs">${cat}</span>
                    </div>`
                ).join('');
                document.getElementById('categories-list').innerHTML = cats || '<span class="text-gray-400">No categories found</span>';
            }

            // --- HTTP Response (URL) ---
            if (type === 'url') {
                document.getElementById('section-http').classList.remove('hidden');
                document.getElementById('http-final-url').textContent = attrs.last_final_url || attrs.url || '-';

                // Try to find serving IP in various places
                const servingIp = attrs.last_serving_ip_address || (attrs.last_http_response_headers ? attrs.last_http_response_headers['serving_ip'] : null) || '-';
                document.getElementById('http-serving-ip').textContent = servingIp;

                // New Fields
                document.getElementById('http-status-code').textContent = attrs.last_http_response_code || '-';
                document.getElementById('http-body-length').textContent = attrs.last_http_response_content_length ? (attrs.last_http_response_content_length + ' bytes') : '-';
                document.getElementById('http-body-sha256').textContent = attrs.last_http_response_content_sha256 || '-';

                // Headers Table
                const headersBody = document.getElementById('http-headers-body');
                headersBody.innerHTML = '';
                const headers = attrs.last_http_response_headers || {};
                const headerKeys = Object.keys(headers);
                const targetHeaders = [
                    'Transfer-Encoding', 'Set-Cookie', 'Expires', 'Server', 'Connection',
                    'Cache-Control', 'Date', 'X-Frame-Options', 'Referrer-Policy', 'Content-Type', 'CF-RAY', 'Set-Cookie', 'Strict-Transport-Security', 'Content-Security-Policy', 'location', 'last-modified', 'x-powered-by', 'x-xss-protection', 'x-content-type-options', 'via', 'accept-ranges', 'etag', 'x-frame-options', 'Content-Disposition'
                ];

                targetHeaders.forEach(target => {
                    const key = headerKeys.find(k => k.toLowerCase() === target.toLowerCase());
                    if (key) {
                        const val = headers[key];
                        const row = document.createElement('tr');
                        row.innerHTML = `<td class="py-2 px-3 font-medium text-gray-600 w-1/3 bg-gray-50">${target}</td><td class="py-2 px-3 text-gray-800 font-mono break-all">${val}</td>`;
                        headersBody.appendChild(row);
                    }
                });
                if (headersBody.children.length === 0) {
                    headersBody.innerHTML = '<tr><td colspan="2" class="p-3 text-gray-400 italic">No relevant headers found</td></tr>';
                }

                // --- HTML Info ---
                if (attrs.html_meta) {
                    document.getElementById('section-html-info').classList.remove('hidden');
                    document.getElementById('html-title').textContent = attrs.html_meta.title || (attrs.title) || '-';

                    const metaContainer = document.getElementById('html-meta-tags');
                    metaContainer.innerHTML = '';
                    Object.entries(attrs.html_meta).forEach(([k, v]) => {
                        if (k === 'title') return;
                        const valStr = Array.isArray(v) ? v.join(', ') : v;
                        const div = document.createElement('div');
                        div.className = "flex flex-col md:flex-row md:items-start gap-1 md:gap-4 border-b border-gray-100 pb-1 last:border-0";
                        div.innerHTML = `<span class="text-xs font-bold text-gray-500 min-w-[120px]">${k}</span><span class="text-xs text-gray-800 font-mono break-all">${valStr}</span>`;
                        metaContainer.appendChild(div);
                    });
                }

                // --- Cookies ---
                if (attrs.last_http_response_cookies && attrs.last_http_response_cookies.length > 0) {
                    document.getElementById('section-cookies').classList.remove('hidden');
                    const cookieContainer = document.getElementById('cookies-list');
                    cookieContainer.innerHTML = '';
                    attrs.last_http_response_cookies.forEach(c => {
                        const div = document.createElement('div');
                        div.className = "bg-gray-50 p-2 rounded border border-gray-200";
                        div.innerHTML = `<div class="font-bold text-blue-700">${c.name}</div><div class="text-xs text-gray-600 break-all">${c.value}</div><div class="mt-1 text-[10px] text-gray-400 flex gap-2"><span>Domain: ${c.domain || '-'}</span><span>Path: ${c.path || '-'}</span></div>`;
                        cookieContainer.appendChild(div);
                    });
                }
            }

            // --- Whois (IP) ---
            if (type === 'ip_address') {
                document.getElementById('section-whois').classList.remove('hidden');
                document.getElementById('whois-content').textContent = attrs.whois || 'No Whois data available.';
                // Also show history for IPs if available
                if (attrs.last_analysis_date) {
                    document.getElementById('section-history').classList.remove('hidden');
                    document.getElementById('hist-last-anal').textContent = formatTime(attrs.last_analysis_date);
                    // Hide submission dates for IPs as they aren't "submitted" like files
                    document.getElementById('hist-first').parentElement.classList.add('hidden');
                    document.getElementById('hist-last-sub').parentElement.classList.add('hidden');
                }
                // Enable Relations Tab for IPs
                document.getElementById('tab-btn-relations').classList.remove('hidden');
            }

            // --- Behavior (File) ---
            if (type === 'file' && REPORT_DATA.behavior && REPORT_DATA.behavior.length > 0) {
                document.getElementById('tab-btn-behavior').classList.remove('hidden');
                renderBehavior(REPORT_DATA.behavior);
            }

            // Attach Listeners
            document.getElementById('summarize-btn').addEventListener('click', summarizeReport);
            document.getElementById('explain-tags-btn').addEventListener('click', explainTags);
        };

        // --- 2. GEMINI PROXY CALL ---
        async function callGemini(userQuery, tools = null, systemPrompt = null) {
            const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
            const apiUrl = '/api/gemini-proxy'; // Calls Python backend
            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ query: userQuery, tools: tools, systemPrompt: systemPrompt })
            });
            const result = await response.json();
            if (result.error || !result.candidates) throw new Error("AI Service Error: " + (result.error?.message || "Unknown error"));
            const candidate = result.candidates[0];
            const text = candidate.content.parts[0].text;
            let sources = [];
            if (candidate.groundingMetadata?.groundingAttributions) {
                sources = candidate.groundingMetadata.groundingAttributions.map(a => ({ uri: a.web?.uri, title: a.web?.title })).filter(s => s.uri);
            }
            return { text, sources };
        }

        // --- 3. FEATURES ---
        async function summarizeReport() {
            if (!REPORT_DATA || !REPORT_DATA.data) return showModal("Error", "No data available", true);

            const btn = document.getElementById('summarize-btn');
            const originalContent = toggleButtonLoading(btn, true);

            try {
                const attrs = REPORT_DATA.data.attributes;
                const analysisData = {
                    file_info: {
                        names: attrs.names ? attrs.names.slice(0, 5) : [],
                        size: attrs.size,
                        type: attrs.type_description,
                        first_seen: attrs.first_submission_date ? new Date(attrs.first_submission_date * 1000).toISOString() : 'Unknown',
                        reputation: attrs.reputation
                    },
                    stats: attrs.last_analysis_stats,
                    tags: attrs.tags,
                    detections: Object.entries(attrs.last_analysis_results || {}).filter(([, v]) => v.category === 'malicious').slice(0, 10).map(([k, v]) => `${k}: ${v.result}`)
                };
                const query = `Perform a comprehensive security assessment on this file based on the VirusTotal report:\n${JSON.stringify(analysisData, null, 2)}`;
                const sysPrompt = `You are a Senior Malware Analyst. Analyze the provided JSON data. Output your response in valid Markdown with the following structure: ### 1. Executive Summary... ### 2. Risk Assessment... ### 3. Technical Analysis... ### 4. Recommendation...`;
                const res = await callGemini(query, null, sysPrompt);
                displayResults(res.text, []);
            } catch (e) { showModal("Analysis Failed", e.message, true); } finally { toggleButtonLoading(btn, false, originalContent); }
        }

        async function explainTags() {
            if (!REPORT_DATA || !REPORT_DATA.data) return showModal("Error", "No data available", true);

            const btn = document.getElementById('explain-tags-btn');
            const originalContent = toggleButtonLoading(btn, true);

            try {
                const tags = REPORT_DATA.data.attributes.tags || [];
                if (tags.length === 0) throw new Error("No technical tags found in this report.");
                const query = `Explain the security implications of these specific tags found on a file: ${tags.join(', ')}`;
                const sysPrompt = `You are a Cybersecurity Educator. 1. Group the tags logically. 2. Define each tag simply. 3. Use Google Search. 4. Output as a clean Markdown list.`;
                const res = await callGemini(query, { google_search: {} }, sysPrompt);
                displayResults(res.text, res.sources, "Technical Tag Breakdown");
            } catch (e) { showModal("Error", e.message, true); } finally { toggleButtonLoading(btn, false, originalContent); }
        }

        // --- 4. UI HELPERS ---
        function displayResults(markdownText, sources, title = "Analysis Results") {
            const container = document.getElementById('llm-content');
            let html = markdownText
                .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-blue-800 mt-4 mb-2 border-b border-blue-200 pb-1">$1</h3>')
                .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-gray-800 mt-4 mb-2">$1</h2>')
                .replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>')
                .replace(/\*(.*?)\*/g, '<em class="text-gray-700">$1</em>')
                .replace(/^\* (.*$)/gim, '<li class="ml-4 list-disc text-gray-700 mb-1">$1</li>')
                .replace(/^- (.*$)/gim, '<li class="ml-4 list-disc text-gray-700 mb-1">$1</li>')
                .replace(/\n/g, '<br />');
            html = html.replace(/<br \/><li/g, '<li').replace(/<\/li><br \/>/g, '</li>');
            let finalHtml = `<div class="prose max-w-none"><h2 class="text-2xl font-bold text-gray-800 mb-4 border-l-4 border-green-500 pl-3">${title}</h2>${html}</div>`;
            if (sources && sources.length > 0) {
                finalHtml += `<div class="mt-6 pt-4 border-t border-gray-200 bg-gray-50 p-3 rounded-lg"><p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Grounding Sources</p><ul class="space-y-1">${sources.map(s => `<li class="text-xs truncate"><a href="${s.uri}" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline flex items-center"><span class="mr-1">🔗</span> ${s.title || s.uri}</a></li>`).join('')}</ul></div>`;
            }
            container.innerHTML = finalHtml;
            // Uses classList to toggle active state based on CSS
            document.getElementById('llm-results').classList.add('active');
        }

        function showModal(title, msg, isErr = false) {
            const m = document.getElementById('message-modal');
            const titleEl = document.getElementById('modal-title');
            titleEl.innerText = title;
            titleEl.className = `text-xl font-bold mb-3 ${isErr ? 'text-red-600' : 'text-gray-800'}`;
            document.getElementById('modal-message').innerText = msg;
            const loading = msg.toLowerCase().includes("wait") || msg.toLowerCase().includes("analyzing") || title.toLowerCase().includes("analyzing");
            document.getElementById('modal-spinner').classList.toggle('hidden', !loading);
            const closeBtn = document.getElementById('modal-close');
            closeBtn.classList.toggle('hidden', loading);
            closeBtn.onclick = () => { m.classList.remove('flex'); };
            m.classList.add('flex');
        }

        function hideModal() {
            const m = document.getElementById('message-modal');
            setTimeout(() => { m.classList.remove('flex'); }, 500);
        }
        function toggleLlmSection() {
            const wrapper = document.getElementById('llm-content-wrapper');
            const icon = document.getElementById('llm-toggle-icon');

            // Toggle Content Visibility
            if (wrapper.classList.contains('content-hidden')) {
                wrapper.classList.remove('content-hidden');
                icon.classList.add('rotate-180');
            } else {
                wrapper.classList.add('content-hidden');
                icon.classList.remove('rotate-180');
            }
        }

        function toggleButtonLoading(btn, isLoading, originalContent = '') {
            if (isLoading) {
                const content = btn.innerHTML;
                // Scale down loader for button
                btn.innerHTML = `<div class="loader" style="width: 20px; height: 20px; font-size: 8px; margin-right: 8px;"></div> Processing...`;
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
                return content;
            } else {
                btn.innerHTML = originalContent;
                btn.disabled = false;
                btn.classList.remove('opacity-75', 'cursor-not-allowed');
            }
        }

        // --- 5. TAB SWITCHING ---
        window.switchTab = function (tabName) {
            ['detection', 'details', 'behavior', 'relations', 'hardlinks'].forEach(t => {
                const btn = document.getElementById(`tab-btn-${t}`);
                const content = document.getElementById(`tab-content-${t}`);
                if (btn && content) {
                    // Prevent unhiding tabs that should remain hidden (e.g. Behavior on non-files)
                    if (btn.classList.contains('hidden')) return;

                    if (t === tabName) {
                        btn.className = "py-3 text-sm font-bold text-blue-600 border-b-2 border-blue-600 focus:outline-none transition-colors";
                        content.classList.remove('hidden');
                    } else {
                        btn.className = "py-3 text-sm font-bold text-gray-500 hover:text-gray-700 focus:outline-none transition-colors";
                        content.classList.add('hidden');
                    }
                }
            });

            if (tabName === 'hardlinks') {
                loadHardLinks();
            } else if (tabName === 'relations') {
                loadRelations();
            }
        };

        let _hardLinksLoaded = false;
        function loadHardLinks() {
            if (_hardLinksLoaded) return;

            const tbody = document.getElementById('hardlinks-table-body');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-gray-500 py-4"><div class="loader inline-block w-4 h-4 mr-2" style="border-top-color:#0d6efd"></div>Searching for matches...</td></tr>';

            // Fetch matches based on the current resource ID and Type
            // Assumes an endpoint like /api/matches exists or handles the query
            fetch(`/api/matches?type=${RESOURCE_TYPE}&value=${encodeURIComponent(RESOURCE_ID)}`)
                .then(res => {
                    if (!res.ok) throw new Error("API response not ok");
                    return res.json();
                })
                .then(data => {
                    _hardLinksLoaded = true;
                    tbody.innerHTML = '';
                    if (!data || data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-gray-500 py-4">No other emails found containing this IOC.</td></tr>';
                        return;
                    }
                    data.forEach(item => {
                        let dateStr = '-';
                        let timeStr = '-';
                        if (item.date) {
                            const d = new Date(item.date);
                            if (!isNaN(d)) {
                                const y = d.getFullYear();
                                const m = String(d.getMonth() + 1).padStart(2, '0');
                                const day = String(d.getDate()).padStart(2, '0');
                                dateStr = `${y}-${m}-${day}`;
                                timeStr = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
                            }
                        }
                        const tr = document.createElement('tr');
                        tr.innerHTML = `<td class="font-medium text-gray-900">${item.subject || '(No Subject)'}</td><td class="text-gray-600">${item.sender || 'Unknown'}</td><td class="text-gray-500 text-xs">${dateStr}</td><td class="text-gray-500 text-xs">${timeStr}</td><td><a href="/detail/${item.id}" target="_blank" class="text-blue-600 hover:underline text-xs font-bold">View Email</a></td>`;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {
                    console.warn("Hard Link Fetch Error:", err);
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-gray-400 py-4 italic">Unable to load matches (API endpoint /api/matches not found).</td></tr>';
                });
        }

        function renderBehavior(behaviorData) {
            const container = document.getElementById('tab-content-behavior');
            container.innerHTML = '';

            // Aggregate Data
            const mitre = new Map();
            const dns = new Set();
            const ips = new Set();
            const files = new Set();
            const registry = new Set();
            const commands = new Set();

            behaviorData.forEach(item => {
                const attrs = item.attributes || {};
                (attrs.mitre_attack_techniques || []).forEach(m => mitre.set(m.id, m.signature_description));
                (attrs.dns_lookups || []).forEach(d => dns.add(d.hostname));
                (attrs.ip_traffic || []).forEach(i => ips.add(i.destination_ip));
                (attrs.files_dropped || []).forEach(f => files.add(f.sha256 || f.path));
                (attrs.registry_keys_set || []).forEach(r => registry.add(r.key || r));
                (attrs.processes_created || []).forEach(p => commands.add(p));
            });

            // Helper to create section
            const createSection = (title, items, icon) => {
                if (items.size === 0) return '';
                const list = Array.from(items).map(i => `<li class="text-xs font-mono text-gray-700 border-b border-gray-100 py-1 last:border-0 break-all">${i}</li>`).join('');
                return `<div class="vt-card !p-4"><h3 class="section-label flex items-center gap-2">${icon} ${title} <span class="ml-auto bg-gray-100 text-gray-600 py-0.5 px-2 rounded-full text-[10px]">${items.size}</span></h3><ul class="max-h-48 overflow-y-auto">${list}</ul></div>`;
            };

            // MITRE Section
            let mitreHtml = '';
            if (mitre.size > 0) {
                const list = Array.from(mitre.entries()).map(([id, desc]) =>
                    `<div class="flex flex-col border-b border-gray-100 py-2 last:border-0"><span class="font-bold text-xs text-red-600">${id}</span><span class="text-xs text-gray-700">${desc}</span></div>`
                ).join('');
                mitreHtml = `<div class="vt-card !p-4 md:col-span-2"><h3 class="section-label flex items-center gap-2">🛡️ MITRE ATT&CK Techniques</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 max-h-60 overflow-y-auto">${list}</div></div>`;
            }

            container.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    ${mitreHtml}
                    ${createSection('DNS Lookups', dns, '🌐')}
                    ${createSection('IP Traffic', ips, '🔌')}
                    ${createSection('Files Dropped', files, '📁')}
                    ${createSection('Registry Keys', registry, '📝')}
                    ${createSection('Processes / Commands', commands, '⚙️')}
                </div>
            `;
        }

        let _relationsLoaded = false;
        function loadRelations() {
            if (_relationsLoaded || RESOURCE_TYPE !== 'ip_address') return;

            // Show loading state
            ['dns', 'comm', 'ref', 'whois'].forEach(rel => {
                const section = document.getElementById(`rel-${rel}-section`);
                const tbody = document.getElementById(`rel-${rel}-tbody`);
                if (section && tbody) {
                    section.classList.remove('hidden');
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-gray-500 py-4"><div class="loader inline-block w-4 h-4 mr-2" style="border-top-color:#0d6efd"></div>Loading...</td></tr>';
                }
            });

            // Fetch all relations at once
            fetch(`/api/fetch_vt_relations/ip_address/${encodeURIComponent(RESOURCE_ID)}`)
                .then(res => {
                    if (!res.ok) throw new Error("API response not ok");
                    return res.json();
                })
                .then(data => {
                    _relationsLoaded = true;
                    renderRelations(data);
                })
                .catch(err => {
                    console.warn("Relations Fetch Error:", err);
                    ['dns', 'comm', 'ref', 'whois'].forEach(rel => {
                        const tbody = document.getElementById(`rel-${rel}-tbody`);
                        if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="text-center text-gray-400 py-4 italic">Unable to load relations data.</td></tr>';
                    });
                });
        }

        function renderRelations(relationsData) {
            // Helper for Date Styling
            const fmtDate = (ts) => {
                if (!ts) return '-';
                const d = new Date(ts * 1000);
                return d.toISOString().replace('T', ' ').substring(0, 16);
            };

            // Helper for Detection Column
            const renderDetection = (stats) => {
                if (!stats) return '<span class="text-gray-400">-</span>';
                const mal = stats.malicious || 0;
                const total = (stats.malicious + stats.undetected + stats.harmless + stats.suspicious) || 0;
                if (mal > 0) {
                    return `<span class="text-red-600 font-bold flex items-center gap-1">
                                <span class="h-2 w-2 rounded-full bg-red-500"></span> ${mal}/${total}
                             </span>`;
                }
                return `<span class="text-green-600 flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-green-500"></span> 0/${total}</span>`;
            };

            // Helper for File Name
            const getFileName = (attrs, id) => {
                if (attrs.names && Array.isArray(attrs.names) && attrs.names.length > 0) return attrs.names[0];
                if (attrs.meaningful_name) return attrs.meaningful_name;
                return `<span class="font-mono text-gray-400 italic" title="Filename unavailable">${id.substring(0, 12)}...</span>`;
            };

            // 1. Passive DNS
            const dnsData = relationsData.resolutions || [];
            const dnsSection = document.getElementById('rel-dns-section');
            if (dnsData.length > 0) {
                dnsSection.classList.remove('hidden');
                document.getElementById('rel-dns-badge').textContent = dnsData.length;
                const tbody = document.getElementById('rel-dns-tbody');
                tbody.innerHTML = dnsData.map(item => {
                    const attrs = item.attributes || {};
                    return `<tr>
                        <td class="whitespace-nowrap text-gray-600">${fmtDate(attrs.date || attrs.last_resolved)}</td>
                        <td>${renderDetection(attrs.host_name_last_analysis_stats || attrs.last_analysis_stats)}</td>
                        <td class="text-gray-600 text-xs">${attrs.resolver || '-'}</td>
                        <td class="font-mono text-sm text-blue-600 break-all">${attrs.host_name || item.id || '-'}</td>
                    </tr>`;
                }).join('');
            } else {
                document.getElementById('rel-dns-tbody').innerHTML = '<tr><td colspan="4" class="text-center text-gray-400 py-4">No DNS resolutions found</td></tr>';
            }

            // 2. Communicating Files
            const commData = relationsData.communicating_files || [];
            const commSection = document.getElementById('rel-comm-section');
            if (commData.length > 0) {
                commSection.classList.remove('hidden');
                document.getElementById('rel-comm-badge').textContent = commData.length;
                const tbody = document.getElementById('rel-comm-tbody');
                tbody.innerHTML = commData.map(item => {
                    const attrs = item.attributes || {};
                    return `<tr>
                        <td class="whitespace-nowrap text-gray-600">${fmtDate(attrs.last_analysis_date)}</td>
                        <td>${renderDetection(attrs.last_analysis_stats)}</td>
                        <td class="text-xs uppercase font-bold text-gray-500">${attrs.type_description || attrs.type_tag || '-'}</td>
                        <td class="font-mono text-xs break-all" title="${item.id}">${getFileName(attrs, item.id)}</td>
                    </tr>`;
                }).join('');
            } else {
                document.getElementById('rel-comm-tbody').innerHTML = '<tr><td colspan="4" class="text-center text-gray-400 py-4">No communicating files found</td></tr>';
            }

            // 3. Files Referring
            const refData = relationsData.referrer_files || [];
            const refSection = document.getElementById('rel-ref-section');
            if (refData.length > 0) {
                refSection.classList.remove('hidden');
                document.getElementById('rel-ref-badge').textContent = refData.length;
                const tbody = document.getElementById('rel-ref-tbody');
                tbody.innerHTML = refData.map(item => {
                    const attrs = item.attributes || {};
                    return `<tr>
                        <td class="whitespace-nowrap text-gray-600">${fmtDate(attrs.last_analysis_date)}</td>
                        <td>${renderDetection(attrs.last_analysis_stats)}</td>
                        <td class="text-xs uppercase font-bold text-gray-500">${attrs.type_description || attrs.type_tag || '-'}</td>
                        <td class="font-mono text-xs break-all" title="${item.id}">${getFileName(attrs, item.id)}</td>
                    </tr>`;
                }).join('');
            } else {
                document.getElementById('rel-ref-tbody').innerHTML = '<tr><td colspan="4" class="text-center text-gray-400 py-4">No referring files found</td></tr>';
            }

            // 4. Historical Whois
            const whoisData = relationsData.historical_whois || [];
            const whoisSection = document.getElementById('rel-whois-section');
            if (whoisData.length > 0) {
                whoisSection.classList.remove('hidden');
                document.getElementById('rel-whois-badge').textContent = whoisData.length;
                const tbody = document.getElementById('rel-whois-tbody');

                const getWhoisField = (map, keys) => {
                    if (!map) return '-';
                    const mapKeys = Object.keys(map);
                    for (let k of keys) {
                        const match = mapKeys.find(mk => mk.toLowerCase().includes(k.toLowerCase()));
                        if (match) return map[match];
                    }
                    return '-';
                };

                tbody.innerHTML = whoisData.map((item, idx) => {
                    const attrs = item.attributes || {};
                    const parsed = attrs.whois_map || {};
                    const org = getWhoisField(parsed, ['organization', 'registrant organization', 'org']);
                    const email = getWhoisField(parsed, ['email', 'registrant email', 'e-mail']);
                    const dateVal = attrs.last_updated || attrs.updated_date || attrs.date;

                    return `<tr>
                        <td class="whitespace-nowrap text-gray-600">${fmtDate(dateVal)}</td>
                        <td class="font-medium text-gray-800 text-xs">${org !== '-' ? org : '<span class="text-gray-300">N/A</span>'}</td>
                        <td class="text-blue-600 text-xs">${email !== '-' ? email : '<span class="text-gray-300">N/A</span>'}</td>
                    </tr>`;
                }).join('');
            } else {
                document.getElementById('rel-whois-tbody').innerHTML = '<tr><td colspan="3" class="text-center text-gray-400 py-4">No historical whois found</td></tr>';
            }
        }

        function copyToClipboard(elementId, btn) {
            const text = document.getElementById(elementId).textContent;
            if (!text || text === '-') return;
            navigator.clipboard.writeText(text).then(() => {
                const original = btn.innerText;
                btn.innerText = "Copied!";
                setTimeout(() => btn.innerText = original, 1500);
            });
        }
    </script>
    <script src="{{ url_for('static', filename='network_check.js') }}"></script>
    <script src="{{ url_for('static', filename='global_notifications.js') }}"></script>
</body>

</html>