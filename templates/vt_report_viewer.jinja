        <div id="raw-json-panel" class="hidden">
            <div class="bg-gray-800 rounded-xl shadow-inner border border-gray-700 overflow-hidden">
                <div class="bg-gray-900 px-4 py-2 border-b border-gray-700 text-xs text-gray-400 font-mono">RAW JSON
                    RESPONSE</div>
                <div class="p-4 max-h-[500px] overflow-auto">
                    <pre class="json-code" id="report-data-json-display"></pre>
                </div>
            </div>
